      <expressionfields>
        <field type="10" typeName="string" precision="0" length="0" name="Nom" subType="0" comment="" expression="concat(&#xd;&#xa;    CASE&#xd;&#xa;        WHEN &quot;NOM_VERN&quot; ='' THEN ' -'&#xd;&#xa;        ELSE regexp_replace(&#xd;&#xa;            regexp_substr(&quot;NOM_VERN&quot;, '^[^,]*'),&#xd;&#xa;            '\\s*\\(.*\\)',&#xd;&#xa;            ''&#xd;&#xa;        )&#xd;&#xa;    END,&#xd;&#xa;    ' (',&#xd;&#xa;    &quot;LB_NOM&quot;,&#xd;&#xa;    ')'&#xd;&#xa;)"/>
        <field type="10" typeName="string" precision="0" length="0" name="reg_cd_ref" subType="0" comment="" expression="attribute( get_feature('Projet', 'fid',  aggregate( 'Projet', 'max', &quot;fid&quot;)), 'Region') ||  &quot;CD_REF&quot; "/>
