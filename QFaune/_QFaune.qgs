        <policy policy="DefaultValue" field="fid"/>
        <policy policy="DefaultValue" field="Nom"/>
        <policy policy="DefaultValue" field="photo"/>
        <policy policy="DefaultValue" field="observation"/>
        <policy policy="DefaultValue" field="Couche"/>
        <policy policy="DefaultValue" field="Heure"/>
      </splitPolicies>
      <defaults>
        <default applyOnUpdate="0" field="fid" expression="if(maximum(&quot;fid&quot;)is null,&#xd;&#xa;&#x9;1,&#xd;&#xa;&#x9;maximum(&quot;fid&quot;)+1)"/>
        <default applyOnUpdate="0" field="Nom" expression=""/>
        <default applyOnUpdate="0" field="photo" expression=""/>
        <default applyOnUpdate="0" field="observation" expression=""/>
        <default applyOnUpdate="0" field="Couche" expression="Case&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Orthoptère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Orthoptère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Mammifère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Mammifère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Coléoptère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Coléoptère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Odonate', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Odonate'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Amphibien', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Habitat ponctuel'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='H_pedologique', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Amphibien'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Reptile', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Reptile'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Lépidoptère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Lépidoptère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Chiroptère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Chiroptère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Chiroptère', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Chiroptère'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Avifaune', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Avifaune'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Arbre', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Arbre'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Fourmis', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Fourmis'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Divers P', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Divers P'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Divers L', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Divers L'&#xd;&#xa;&#xd;&#xa;When regexp_match(&quot;Reference&quot;, array_to_string(aggregate(layer:='Divers S', aggregate:='array_agg', expression:=&quot;uuid&quot;), '|'))&#xd;&#xa;Then 'Divers S'&#xd;&#xa;&#xd;&#xa;Else 'Inconnu'&#xd;&#xa;End"/>
        <default applyOnUpdate="0" field="Heure" expression="now()"/>
      </defaults>
