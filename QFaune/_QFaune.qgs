      <defaults>
        <default applyOnUpdate="0" field="fid" expression="if(maximum(&quot;fid&quot;) is null,&#xd;&#xa;   1,&#xd;&#xa;   maximum(&quot;fid&quot;+1))"/>
        <default applyOnUpdate="0" field="Nom" expression=""/>
        <default applyOnUpdate="0" field="Autre" expression=""/>
        <default applyOnUpdate="0" field="Protocole" expression="'Opportuniste'"/>
        <default applyOnUpdate="0" field="Nombre" expression=""/>
        <default applyOnUpdate="0" field="Comportement" expression=""/>
        <default applyOnUpdate="0" field="Stade de vie" expression=""/>
        <default applyOnUpdate="0" field="Direction" expression=""/>
        <default applyOnUpdate="0" field="Date" expression="now()"/>
        <default applyOnUpdate="0" field="Heure" expression="now()"/>
        <default applyOnUpdate="0" field="Vent" expression="attribute( get_feature('Météo', 'fid',  aggregate( 'Météo', 'max', &quot;fid&quot;)), 'Vent')"/>
        <default applyOnUpdate="0" field="Temperature" expression="attribute( get_feature('Météo', 'fid',  aggregate( 'Météo', 'max', &quot;fid&quot;)), 'Temperature')"/>
        <default applyOnUpdate="0" field="Ciel" expression="attribute( get_feature('Météo', 'fid',  aggregate( 'Météo', 'max', &quot;fid&quot;)), 'Ciel')"/>
        <default applyOnUpdate="0" field="Commentaire" expression=""/>
        <default applyOnUpdate="0" field="Doute" expression=""/>
        <default applyOnUpdate="0" field="uuid" expression="uuid('WithoutBraces')"/>
        <default applyOnUpdate="0" field="Projet" expression="attribute( get_feature('Projet', 'fid',  aggregate( 'Projet', 'max', &quot;fid&quot;)), 'Nom')"/>
        <default applyOnUpdate="0" field="Observateur" expression="attribute( get_feature('Projet', 'fid',  aggregate( 'Projet', 'max', &quot;fid&quot;)), 'Observateur')"/>
        <default applyOnUpdate="1" field="Type" expression="case &#xd;&#xa;when Comportement in&#xd;&#xa;('2 - Présence','3 - Mâle chanteur','30 - Nidification possible')&#xd;&#xa;then&#xd;&#xa;'Nicheur possible'&#xd;&#xa;&#xd;&#xa;when Comportement in&#xd;&#xa;('4 - Couple','5 - Comportement territorial','6 - Comportement nuptial','7 - Site de nidification probable','8 - Cri d''alarme','9 - Preuve physiologique','10 - Construction d''un nid','40 - Nidification probable')&#xd;&#xa;then&#xd;&#xa;'Nicheur probable'&#xd;&#xa;&#xd;&#xa;when Comportement in&#xd;&#xa;('11 - Oiseau simulant une blessure','12 - Nid vide ou coquilles d’œufs anciennes','13 - Jeunes','14 - Nid occupé','15 - Adulte transportant un sac fécal','16 - Adulte transportant de la nourriture','17 - Coquilles d''oeufs éclos','18 - Nid vu avec un adulte couvant','19 - Nid contenant des oeufs ou des jeunes','50 - Nidification certaine')&#xd;&#xa;then&#xd;&#xa;'Nicheur certain'&#xd;&#xa;&#xd;&#xa;when Comportement in&#xd;&#xa;('99 - Espèce absente malgré des recherches')&#xd;&#xa;then&#xd;&#xa;'Pas d''observation'&#xd;&#xa;&#xd;&#xa;when Comportement in&#xd;&#xa;('Hivernant')&#xd;&#xa;then&#xd;&#xa;'Hivernant'&#xd;&#xa;&#xd;&#xa;when Comportement in&#xd;&#xa;('Migrateur')&#xd;&#xa;then&#xd;&#xa;'Migrateur'&#xd;&#xa;end"/>
        <default applyOnUpdate="0" field="Sexe" expression=""/>
        <default applyOnUpdate="0" field="Groupe" expression=""/>
